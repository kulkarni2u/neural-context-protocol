[store]
type = "sqlite"
path = ".ncp/store.db"

[redis]
url = "redis://127.0.0.1:6379/0"
stream = "ncp:whispers"

[pgvector]
dsn = "postgresql://postgres:postgres@127.0.0.1:5432/ncp"
schema = "ncp"
table_prefix = "ncp_"

[pipeline]
default_ttl_hours = 24
max_working_chunks = 500
gc_threshold = 400
cold_start_retry = 2

[budget]
max_tokens_per_call = 4000
context_token_budget = 840
warn_at_ratio = 0.70
critical_at_ratio = 0.85
recent_slot_budget = 2
# CAP-E2: per-pipeline $ spend ceiling over real (CAP-E1) recorded cost. None
# (default) disables the governor entirely -- ncp_get_context/ncp_post_turn
# never surface a "budget" block when this is unset.
# pipeline_budget_usd = 5.00
# Fraction of pipeline_budget_usd at which status flips from "ok" to
# "warning" (default 0.8).
# budget_warn_fraction = 0.8
# "off" (no governance), "warn" (surface status, never refuse), or "block"
# (ncp_get_context returns {"budget_exceeded": true, ...} once exceeded).
# budget_enforcement = "warn"
# CAP-C6: adaptive per-turn context token budget. Default false (opt-in) --
# disabled reproduces legacy behavior exactly (static context_token_budget,
# no "budget_tokens" response field). When enabled, ncp_get_context scales
# the effective token budget between the floor/ceiling below based on turn
# difficulty (query length, drift, pressure, slot cadence) and CAP-E2 $
# budget pressure -- see ncp/adaptive_budget.py for the formula. An explicit
# caller max_tokens is always honored as-is; adaptation only fills in when
# max_tokens is omitted.
# adaptive_budget_enabled = false
# adaptive_budget_floor_tokens = 300
# adaptive_budget_ceiling_tokens = 2000

[chunking]
max_chunk_tokens = 200
default_type = "auto"

[whispers]
default_ttl_seconds = 1800
max_per_drain = 3
min_confidence = 0.60
# Drop whispers whose author's Beta-reputation confidence is below this
# threshold (CAP-T4). 0.0 (default) disables gating. NOTE: this gates on the
# whisper's claimed sender — sender identity is only as strong as
# [identity].require_signatures enforcement, so enable that too if authorship
# matters.
# min_author_reputation = 0.0

[handoff]
require_verified = false

[observability]
log_level = "info"
log_format = "pretty"
cost_tracking = true

[reputation]
gain = 4.0
forget = 0.99
confidence_k = 20

# [retrieval]
# Redundancy-aware MMR selection before context budget fitting.
# 1.0 preserves pure relevance ordering; 0.7 is a recommended starting point.
# diversity_lambda = 1.0
# Blend each author's reputation confidence into chunk trust at query time
# (CAP-T4): blended = (1-w)*base_trust + w*confidence. 0.0 (default) disables.
# reputation_weight = 0.0
# Scale of the retrieval-count prior during `ncp calibrate --feedback` once
# outcome evidence (CAP-T3) exists; 1.0 (default) keeps the historical prior,
# 0.0 makes recorded outcomes the only trust signal.
# usage_prior_weight = 1.0

# [memoization]
# Opt-in semantic work memoization (CAP-C3). Lookup-only: the host decides
# whether a returned memo lets it skip its model call.
# Master switch; ncp_lookup_memo returns nothing while false (default).
# enabled = false
# Memos older than this many hours are treated as stale misses (default 24).
# max_age_hours = 24
# Minimum recorded outcome score a memo needs to be returned (default 0.0).
# min_outcome = 0.0
# Return memos that were never verified via update_memo_outcome (default false).
# allow_unverified = false
# Reserved for similarity-based signature matching (default 0.95; exact
# signature match is what ships today).
# similarity_threshold = 0.95

# [tools]
# MCP tool surface: "full" (default) advertises all generally available
# tools, while "core" exposes only the bounded per-turn context lifecycle.
# profile = "full"

# [embedding]
# Opt-in local semantic embeddings for SQLite hybrid/vector retrieval. Install
# with: pip install 'neural-context-protocol[local-embeddings]'
# enabled = true
# provider = "local"
# model = "BAAI/bge-small-en-v1.5"

# [distillation]
# Opt-in extractive distillation for oversized chunks during assembly.
# enabled = false
# min_chunk_tokens = 120

# [retention]
# Cap on `working`-zone chunks retained per pipeline. When exceeded, the
# lowest trust/recency-scored chunks are evicted on write. 0 disables
# retention enforcement (default, backward compatible).
# max_working_chunks_per_pipeline = 5000

# [server]
# Bearer token required for HTTP requests when set. The server requires no
# token on loopback (127.0.0.1/localhost/::1) by default, but you must set
# this (or NCP_AUTH_TOKEN, or `ncp serve --auth-token`) before binding to a
# non-loopback host. `ncp init --store pgvector` generates one automatically.
# auth_token = ""

# [identity]
# OPT-IN Ed25519 authorship enforcement (CAP-T1, WI-013). When false (default),
# unsigned writes/whispers keep working and any supplied signature is verified
# and recorded but never required. Set to true to REJECT any write/emit whose
# authorship cannot be verified (missing/bad signature or revoked identity).
# require_signatures = false

# [tiering]
# CAP-E3: advisory model-tiering signal (tier_hint/complexity_signal/factors)
# on ncp_get_context responses. NCP never routes models itself. Default true;
# set false to omit the fields entirely.
# tier_hints_enabled = true

# [drift]
# CAP-T5: compute drift_score from observable turn history instead of trusting
# the client's self-reported value (see ncp/drift.py for the exact formula).
# Default false (opt-in); disabled preserves exact legacy self-reported
# behavior with no response change. When enabled, ncp_get_context overrides
# ConsciousBlock.drift_score with the computed value before tiering/adaptive
# budget consume it, and the response gains a "drift" block showing both the
# computed score and the original self-reported value.
# drift_computed_enabled = false
# drift_window_turns = 5
# Optional local-embedding cosine-distance blend on top of the always-on
# lexical baseline. Requires the fastembed-backed [local-embeddings] extra;
# silently falls back to lexical-only when it is not installed.
# drift_use_embeddings = false
