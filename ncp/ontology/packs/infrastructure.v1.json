{
  "id": "infrastructure",
  "version": 1,
  "entity_types": {
    "Service": {"required": ["name", "environment"], "tag": "svc"},
    "KafkaTopic": {"required": ["cluster", "name"], "tag": "topic"},
    "Database": {"required": ["name"], "tag": "db"},
    "API": {"required": ["name"], "tag": "api"},
    "Incident": {"required": ["incident_key"], "tag": "inc"},
    "Team": {"required": ["name"], "tag": "team"}
  },
  "relation_types": {
    "PRODUCES": {"from": ["Service"], "to": ["KafkaTopic"], "intents": ["dependency"]},
    "CONSUMES": {"from": ["Service"], "to": ["KafkaTopic"], "intents": ["dependency"]},
    "DEPENDS_ON": {"from": ["Service"], "to": ["Service", "Database", "API"], "intents": ["dependency"]},
    "EXPOSES": {"from": ["Service"], "to": ["API"]},
    "OWNS": {"from": ["Team"], "to": ["Service"], "intents": ["ownership"]}
  }
}
